<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource VoiceSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            Padding="18,14" TextElement.Foreground="{StaticResource Ink}">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="Elapsed" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           FontFamily="Consolas" Margin="8,0,0,0"/>
                <TextBlock x:Name="Status" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="ActionLabel" Style="{StaticResource Caption}" Margin="20,2,0,0"/>
            <Border x:Name="Meter" Height="6" CornerRadius="3" Background="{StaticResource SubtleSurface}" Margin="0,10,0,0">
                <Border x:Name="MeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Accent}"/>
            </Border>
            <ScrollViewer x:Name="ResultScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <TextBlock x:Name="ResultText"/>
            </ScrollViewer>
            <TextBlock x:Name="NoticeText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="RetryButton" Content="重新處理" Click="Retry_Click" Focusable="False"/>
                <Button x:Name="CopyButton" Content="複製" Style="{StaticResource Primary}" Click="Copy_Click" Focusable="False"/>
                <Button Content="關閉" Click="Close_Click" Focusable="False" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{StaticResource Faint}"
                       Text="再按一次右 Ctrl 完成 · Esc 取消"/>
        </StackPanel>
    </Border>
