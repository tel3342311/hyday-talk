<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="4,0,0,12">
        <DockPanel>
            <Image x:Name="Logo" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Hyday Talk" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusLine" Style="{StaticResource Caption}"/>
            </StackPanel>
        </DockPanel>
        <Border x:Name="PermissionBanner" Background="{StaticResource AccentSurface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="12" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="PermissionButton" Click="FixPermission_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PermissionText" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border x:Name="UpdateBanner" Background="{StaticResource ActionSurface}" BorderBrush="{StaticResource Action}" BorderThickness="1"
                CornerRadius="12" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="UpdateButton" Click="Update_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </StackPanel>
    <TabControl x:Name="Tabs" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}">
        <TabItem Header="總覽" x:Name="OverviewTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <UniformGrid Columns="4" x:Name="MetricGrid">
                        <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                            <StackPanel><TextBlock Text="今天口述" Style="{StaticResource Caption}"/><TextBlock x:Name="TodayWords" FontSize="26"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                            <StackPanel><TextBlock Text="累計字數" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalWords" FontSize="26"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                            <StackPanel><TextBlock Text="節省時間" Style="{StaticResource Caption}"/><TextBlock x:Name="SavedTime" FontSize="26"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                            <StackPanel><TextBlock Text="口述速度" Style="{StaticResource Caption}"/><TextBlock x:Name="Speed" FontSize="26"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="InsightLine" Style="{StaticResource Caption}"/>
                    <TextBlock Text="最近 14 天" Style="{StaticResource Section}"/>
                    <ItemsControl x:Name="DailyBars" Height="70">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="2,0" CornerRadius="3"
                                        Background="{StaticResource Accent}" ToolTip="{Binding Tip}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="常用 App" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="TopApps" Style="{StaticResource Caption}"/>
                    <TextBlock Text="快捷鍵" Style="{StaticResource Section}"/>
                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurface}" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="13"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Windows 鍵盤不會把 fn 鍵傳給應用程式，所以改用右 Ctrl：按一下開始，再按一下完成。"/>
                    <TextBlock Text="最近的聽寫" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource Caption}" Text="還沒有聽寫紀錄。在任何 App 的輸入框按右 Ctrl 試試看。"/>
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="12" Padding="12,8" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="語音辨識" x:Name="SpeechTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="辨識來源" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SpeechBackendBox" SelectionChanged="SpeechBackend_Changed"/>
                    <TextBlock Text="辨識語言" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="LocaleBox" SelectionChanged="Locale_Changed"/>

                    <StackPanel x:Name="SystemSpeechPanel">
                        <TextBlock Style="{StaticResource Caption}" Text="使用 Windows 內建的語音辨識，需要開啟線上語音辨識並安裝辨識語言；不會保留錄音，失敗時無法重新處理。"/>
                        <TextBlock x:Name="SystemSpeechStatus" Margin="0,6,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="開啟語音隱私權設定" Click="OpenSpeechPrivacy_Click"/>
                            <Button Content="新增語音辨識語言" Click="OpenSpeechLanguages_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="LocalSpeechPanel">
                        <TextBlock Text="本機辨識引擎" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Hyday Talk 內建 whisper-cli.exe 與 transcribe-cli.exe；也可以選擇其他 whisper.cpp 的 whisper-cli.exe。Qwen3-ASR 與 TEA-ASR 模型使用同一個資料夾中的 transcribe-cli.exe。"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="選擇…" Click="BrowseEngine_Click" Margin="8,2,0,8"/>
                            <TextBox x:Name="EngineBox" LostFocus="Engine_LostFocus"/>
                        </DockPanel>
                        <TextBlock Text="本機模型" Style="{StaticResource Section}"/>
                        <ItemsControl x:Name="ModelList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="12" Padding="12,8" Margin="0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding ActionTitle}" IsEnabled="{Binding CanAct}" Tag="{Binding}"
                                                    Click="ModelAction_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="選擇模型檔…" Click="BrowseModel_Click" Margin="8,2,0,8"/>
                            <TextBox x:Name="ModelPathBox" IsReadOnly="True"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="SpeechAPIPanel">
                        <TextBlock Text="辨識服務" Style="{StaticResource Section}"/>
                        <ComboBox x:Name="SpeechProviderBox" SelectionChanged="SpeechProvider_Changed"/>
                        <TextBlock Text="服務網址" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="SpeechURLBox" LostFocus="SpeechAPI_LostFocus"/>
                        <TextBlock Text="模型名稱" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="SpeechModelBox" LostFocus="SpeechAPI_LostFocus"/>
                        <TextBlock Text="API Key（存放於 Windows 認證管理員）" Style="{StaticResource Caption}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="儲存 Key" Click="SaveSpeechKey_Click" Margin="8,2,0,8"/>
                            <PasswordBox x:Name="SpeechKeyBox"/>
                        </DockPanel>
                        <Button x:Name="SpeechKeyPage" Content="取得 API Key" Click="OpenSpeechKeyPage_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="文字整理" x:Name="TextTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="整理方式" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="TextBackendBox" SelectionChanged="TextBackend_Changed"/>
                    <TextBlock Text="聽寫風格" Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="StyleBox" SelectionChanged="Style_Changed"/>
                    <TextBlock x:Name="StyleDetail" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="StyleExample" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                    <StackPanel x:Name="LocalTextPanel">
                        <TextBlock Text="Ollama 模型" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="先安裝 Ollama（ollama.com/download），逐字稿只在這台電腦處理。"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="重新整理" Click="RefreshOllama_Click" Margin="8,2,0,8"/>
                            <ComboBox x:Name="OllamaModelBox" SelectionChanged="OllamaModel_Changed"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PullButton" Content="安裝推薦模型 qwen3.5:9b" Click="PullModel_Click"/>
                            <TextBlock x:Name="PullStatus" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ClaudePanel">
                        <TextBlock Text="Claude" Style="{StaticResource Section}"/>
                        <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="ClaudeModelBox" SelectionChanged="ClaudeModel_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="TextAPIPanel">
                        <TextBlock Text="文字服務" Style="{StaticResource Section}"/>
                        <ComboBox x:Name="TextProviderBox" SelectionChanged="TextProvider_Changed"/>
                        <TextBlock Text="服務網址" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="TextURLBox" LostFocus="TextAPI_LostFocus"/>
                        <TextBlock Text="模型名稱" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="TextModelBox" LostFocus="TextAPI_LostFocus"/>
                        <TextBlock Text="API Key（存放於 Windows 認證管理員）" Style="{StaticResource Caption}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="儲存 Key" Click="SaveTextKey_Click" Margin="8,2,0,8"/>
                            <PasswordBox x:Name="TextKeyBox"/>
                        </DockPanel>
                        <Button x:Name="TextKeyPage" Content="取得 API Key" Click="OpenTextKeyPage_Click" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock Text="畫面上下文" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="ScreenContextBox" Content="開始錄音時讀取游標附近的英文詞與產品名稱，讓 AI 寫對專有名詞" Click="ScreenContext_Changed"/>
                    <TextBlock Style="{StaticResource Caption}" Text="只交給文字 AI 參考寫法，不插入也不保存；密碼欄位與以下 App 不讀取（以「、」或逗號分隔）。"/>
                    <TextBox x:Name="ExcludedAppsBox" LostFocus="ExcludedApps_LostFocus"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="個人辭典" x:Name="DictionaryTab">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Caption}"
                               Text="記錄常說的人名、產品與術語，提供給語音辨識與文字 AI 當提示。常聽錯成可填多個，以「、」或逗號分隔。"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="正確寫法" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="TermBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="常聽錯成（選填）" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="MisheardBox"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="新增" Style="{StaticResource Primary}" Click="AddTerm_Click"
                                VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </Grid>
                    <CheckBox x:Name="LearnBox" Content="自動學習詞彙：從我修改插入文字的地方學習人名、產品與術語" Click="Learn_Changed"/>
                    <TextBlock x:Name="LearnStatus" Style="{StaticResource Caption}"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="刪除選取的詞彙" Click="RemoveTerm_Click" HorizontalAlignment="Left"/>
                <ListView x:Name="DictionaryList" Margin="0,8,0,8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="正確寫法" Width="220" DisplayMemberBinding="{Binding Term}"/>
                            <GridViewColumn Header="常聽錯成" Width="260" DisplayMemberBinding="{Binding Heard}"/>
                            <GridViewColumn Header="來源" Width="100" DisplayMemberBinding="{Binding Source}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="Hyday" x:Name="HydayTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Hyday Talk 直接讀寫 Hyday 的筆記資料夾，不需要開啟 Hyday。按右 Ctrl ＋ Space 說話，內容會加在當天日誌的最後面。"/>
                    <TextBlock Text="Hyday 資料夾" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="HydayFolderText"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="選擇資料夾…" Click="ChooseHydayFolder_Click"/>
                        <Button x:Name="HydayDefaultButton" Content="沿用 Hyday 的設定" Click="ResetHydayFolder_Click"/>
                        <Button Content="開啟今天的日誌" Click="OpenJournal_Click"/>
                    </StackPanel>
                    <TextBlock Text="問筆記" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="AskNotesBox" Content="文字提問時先搜尋 Hyday 筆記，以找到的內容回答並附上筆記連結" Click="AskNotes_Changed"/>
                    <TextBlock Text="Hyday 詞彙" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="VocabularyStatus" Style="{StaticResource Caption}"/>
                    <WrapPanel x:Name="VocabularyList" Margin="0,6,0,0"/>
                    <Button Content="重新掃描" Click="RescanVocabulary_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="紀錄" x:Name="HistoryTab">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="複製選取的文字" Click="CopyRecord_Click"/>
                        <Button x:Name="RetryRecordButton" Content="重新處理" Click="RetryRecord_Click"/>
                        <Button Content="刪除選取" Click="DeleteRecord_Click"/>
                        <Button Content="清除全部紀錄" Click="ClearHistory_Click"/>
                    </StackPanel>
                    <DockPanel>
                        <TextBlock Text="保留錄音" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox x:Name="RetentionBox" Width="160" SelectionChanged="Retention_Changed" HorizontalAlignment="Left"/>
                        <Button Content="刪除全部錄音" Click="DeleteRecordings_Click" Margin="8,2,8,8"/>
                        <TextBlock x:Name="RecordingSize" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </DockPanel>
                </StackPanel>
                <ListView x:Name="HistoryList" Margin="0,0,0,8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="時間" Width="110" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="功能" Width="80" DisplayMemberBinding="{Binding Action}"/>
                            <GridViewColumn Header="輸出到" Width="110" DisplayMemberBinding="{Binding Destination}"/>
                            <GridViewColumn Header="文字" Width="380" DisplayMemberBinding="{Binding Text}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </TabItem>

        <TabItem Header="一般" x:Name="GeneralTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <CheckBox x:Name="AutoInsertBox" Content="自動插入到原本的輸入框（關閉時只保留在結果區）" Click="General_Changed"/>
                    <CheckBox x:Name="SaveHistoryBox" Content="保存聽寫紀錄（最多 200 筆）" Click="General_Changed"/>
                    <CheckBox x:Name="SoundsBox" Content="開始與完成錄音時播放提示音" Click="General_Changed"/>
                    <CheckBox x:Name="StartupBox" Content="登入 Windows 時自動啟動" Click="Startup_Changed"/>
                    <TextBlock Text="翻譯目標語言" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="TargetLanguageBox" IsEditable="True" LostFocus="TargetLanguage_Changed" SelectionChanged="TargetLanguage_Changed"/>
                    <TextBlock Text="麥克風" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="MicrophoneBox" SelectionChanged="Microphone_Changed"/>
                    <TextBlock x:Name="MicrophoneStatus" Style="{StaticResource Caption}"/>
                    <Button Content="開啟麥克風隱私權設定" Click="OpenMicrophonePrivacy_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <TextBlock Text="打字速度（估算節省時間用，每分鐘字數）" Style="{StaticResource Section}"/>
                    <TextBox x:Name="TypingSpeedBox" Width="100" HorizontalAlignment="Left" LostFocus="TypingSpeed_LostFocus"/>
                    <TextBlock Text="更新" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"/>
                    <Button Content="檢查更新" Click="CheckUpdate_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <TextBlock Text="資料位置" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="開啟資料夾" Click="OpenData_Click"/>
                        <Button Content="結束 Hyday Talk" Click="Quit_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</DockPanel>
