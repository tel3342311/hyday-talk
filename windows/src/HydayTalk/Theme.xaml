<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors follow DESIGN.md so the Windows app matches the macOS one. -->
    <SolidColorBrush x:Key="Workspace" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Card" Color="#FCFCFC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleSurface" Color="#ECEBEC"/>
    <SolidColorBrush x:Key="VoiceSurface" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="Ink" Color="#1F2328"/>
    <SolidColorBrush x:Key="Muted" Color="#6A6F78"/>
    <SolidColorBrush x:Key="Faint" Color="#A3A8B1"/>
    <SolidColorBrush x:Key="Border" Color="#E3E5E9"/>
    <SolidColorBrush x:Key="Accent" Color="#F2622E"/>
    <SolidColorBrush x:Key="AccentSurface" Color="#FFF1E9"/>
    <SolidColorBrush x:Key="Action" Color="#2E6BF0"/>
    <SolidColorBrush x:Key="ActionSurface" Color="#EEF3FF"/>
    <SolidColorBrush x:Key="Success" Color="#1F9D62"/>
    <SolidColorBrush x:Key="Danger" Color="#CF302A"/>

    <FontFamily x:Key="UIFont">Segoe UI, Microsoft JhengHei UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,2,0,8"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,2,0,8"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,2,8,8"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Action}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Action}"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>
</ResourceDictionary>
